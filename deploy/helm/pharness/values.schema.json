{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["features", "organization", "api", "inferenceGateway", "inferenceEvaluation", "codexAgentBackend", "worker", "ui", "environmentProfiles", "ingress", "networkPolicy", "protectedProductionTarget", "retention", "archivePersistence"],
  "properties": {
    "features": {
      "type": "object",
      "required": ["repoModeV1", "codingReliabilityV2"],
      "properties": {
        "repoModeV1": {
          "type": "object",
          "required": ["enabled", "uiEnabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "uiEnabled": { "type": "boolean" },
            "designOverhaulEnabled": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "codingReliabilityV2": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "required": ["id", "key", "displayName"],
      "properties": {
        "id": { "type": "string", "pattern": "^org_[A-Za-z0-9._-]{1,120}$" },
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      },
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "required": ["image", "operationalMode", "legacyWorkItemCreationEnabled", "databaseGeneration", "persistence"],
      "properties": {
        "image": { "$ref": "#/$defs/immutableImage" },
        "operationalMode": { "enum": ["normal", "draining", "read_only"] },
        "legacyWorkItemCreationEnabled": { "type": "boolean" },
        "databaseGeneration": {
          "type": "object",
          "required": ["id", "purpose", "adoptExisting", "accepted"],
          "properties": {
            "id": { "type": "string", "pattern": "^dbgen_[A-Za-z0-9._-]{1,120}$" },
            "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
            "adoptExisting": { "type": "boolean" },
            "accepted": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "required": ["create", "claimName", "existingClaim", "retain", "storageClass", "size"],
          "properties": {
            "create": { "type": "boolean" },
            "claimName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
            "existingClaim": { "type": "string", "maxLength": 253 },
            "retain": { "const": true },
            "storageClass": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" }
          },
          "allOf": [
            {
              "if": { "properties": { "create": { "const": true } }, "required": ["create"] },
              "then": { "properties": { "existingClaim": { "maxLength": 0 } } },
              "else": { "properties": { "existingClaim": { "minLength": 1 } } }
            }
          ],
          "additionalProperties": false
        }
      }
    },
    "inferenceGateway": {
      "type": "object",
      "required": ["enabled", "directFireworksEnabled", "image", "replicas", "grantSecretName", "grantSecretKey", "fireworksCredential", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "directFireworksEnabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/immutableImage" },
        "replicas": { "const": 1 },
        "grantSecretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "grantSecretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,253}$" },
        "fireworksCredential": {
          "type": "object",
          "required": ["secretName", "secretKey"],
          "properties": {
            "secretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
            "secretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,253}$" }
          },
          "additionalProperties": false
        },
        "resources": { "type": "object" }
      },
      "additionalProperties": false
    },
    "inferenceEvaluation": {
      "type": "object",
      "required": ["image", "nodeHostname"],
      "properties": {
        "image": { "$ref": "#/$defs/immutableImage" },
        "nodeHostname": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" }
      },
      "additionalProperties": false
    },
    "codexAgentBackend": {
      "type": "object",
      "required": ["enabled", "registryFile", "codexVersion", "enrollmentTtlSeconds", "capabilityTtlSeconds", "leaseTtlSeconds", "image", "kubernetes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "registryFile": { "const": "files/agent-execution-registry.json" },
        "codexVersion": { "const": "codex-cli 0.150.1" },
        "enrollmentTtlSeconds": { "const": 900 },
        "capabilityTtlSeconds": { "minimum": 46, "maximum": 900, "type": "integer" },
        "leaseTtlSeconds": { "const": 45 },
        "image": { "$ref": "#/$defs/immutableImage" },
        "kubernetes": {
          "type": "object",
          "required": ["enabled", "hostPool", "authenticationClass", "apiKeySecretName", "apiKeySecretKey", "enrollmentSecretName", "enrollmentIdKey", "enrollmentTokenKey", "sourceReaderSecretName", "sourceReaderSecretKey", "storageClass", "workspaceSize", "profiles"],
          "properties": {
            "enabled": { "type": "boolean" },
            "hostPool": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "authenticationClass": { "const": "api_key" },
            "apiKeySecretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
            "apiKeySecretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,253}$" },
            "enrollmentSecretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
            "enrollmentIdKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,253}$" },
            "enrollmentTokenKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,253}$" },
            "sourceReaderSecretName": { "type": "string", "maxLength": 253 },
            "sourceReaderSecretKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,253}$" },
            "storageClass": { "type": "string", "minLength": 1 },
            "workspaceSize": { "type": "string", "pattern": "^[1-9][0-9]*(Gi|Ti)$" },
            "profiles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["id", "enabled", "image"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
                  "enabled": { "type": "boolean" },
                  "image": { "type": "string", "pattern": "^[^@[:space:]]+@sha256:[0-9a-f]{64}$" }
                },
                "additionalProperties": false
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "properties": { "profiles": { "contains": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] } } } }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": ["scheduledEnabled", "intervalSeconds", "automaticExecutionEnabled", "previewOnly"],
      "properties": {
        "scheduledEnabled": { "type": "boolean" },
        "intervalSeconds": { "type": "integer", "minimum": 3600, "maximum": 604800 },
        "automaticExecutionEnabled": { "type": "boolean" },
        "previewOnly": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "archivePersistence": {
      "type": "object",
      "required": ["enabled", "claimName", "archivedGenerationId", "retain", "storageClass", "size"],
      "properties": {
        "enabled": { "type": "boolean" },
        "claimName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "archivedGenerationId": { "type": "string", "pattern": "^dbgen_[A-Za-z0-9._-]{1,120}$" },
        "retain": { "const": true },
        "storageClass": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "required": ["sourceReader"],
      "properties": {
        "sourceReader": { "$ref": "#/$defs/sourceReader" }
      }
    },
    "ui": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "$ref": "#/$defs/immutableImage" }
      }
    },
    "environmentProfiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/environmentProfile" }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "apiEnabled", "className", "clusterIssuer", "uiTlsSecretName", "apiTlsSecretName", "basicAuthSecretName", "agentHostApi"],
      "properties": {
        "enabled": { "type": "boolean" },
        "apiEnabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1, "maxLength": 63 },
        "clusterIssuer": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "uiTlsSecretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "apiTlsSecretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "basicAuthSecretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "agentHostApi": {
          "type": "object",
          "required": ["enabled", "host", "tlsSecretName"],
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
            "tlsSecretName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "egressProxy"],
      "properties": {
        "enabled": { "const": true },
        "egressProxy": {
          "type": "object",
          "required": ["enabled", "preparationAllowedHosts", "codingAllowedHosts"],
          "properties": {
            "enabled": { "const": true },
            "preparationAllowedHosts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["github.com", "pypi.org", "files.pythonhosted.org", "registry.npmjs.org"] }
            },
            "codingAllowedHosts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["api.fireworks.ai", "api.openai.com"] }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "protectedProductionTarget": {
      "type": "object",
      "required": ["enabled", "environment", "namespace", "argoApplication", "workloadKind", "workloadName", "sourceRepo", "gitOpsRepo", "kustomizationPath", "imageName", "rollbackOwner"],
      "properties": {
        "enabled": { "const": true },
        "environment": { "const": "production" },
        "namespace": { "const": "apps-prod" },
        "argoApplication": { "const": "yfinance-wrapper" },
        "workloadKind": { "const": "Deployment" },
        "workloadName": { "const": "yfinance-wrapper" },
        "sourceRepo": { "const": "https://github.com/lward27/yfinance_wrapper.git" },
        "gitOpsRepo": { "const": "https://github.com/lward27/lucas_engineering.git" },
        "kustomizationPath": { "const": "charts/yfinance-wrapper/kustomization.yaml" },
        "imageName": { "const": "registry.lucas.engineering/yfinance_wrapper" },
        "rollbackOwner": { "const": "lucas" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "features": {
            "properties": {
              "repoModeV1": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["repoModeV1"]
          }
        },
        "required": ["features"]
      },
      "then": {
        "properties": {
          "worker": {
            "properties": {
              "sourceReader": {
                "properties": { "enabled": { "const": true } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "immutableImage": {
      "type": "object",
      "required": ["repository", "digest", "revision", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "not": { "pattern": "@sha256:" } },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pullPolicy": { "enum": ["IfNotPresent", "Never"] }
      },
      "additionalProperties": false
    },
    "sourceReader": {
      "type": "object",
      "required": ["enabled", "serviceAccount", "tokenSecretName", "allowedRepos", "activeDeadlineSeconds", "ttlSecondsAfterFinished"],
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceAccount": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "tokenSecretName": { "type": "string", "maxLength": 253 },
        "allowedRepos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+\\.git$" }
        },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 1, "maximum": 86400 }
      },
      "additionalProperties": false
    },
    "environmentProfile": {
      "type": "object",
      "required": ["id", "active", "image", "revision", "platform", "required_executables", "preparation_strategy", "service_account", "repository_allowlist", "limits"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "active": { "type": "boolean" },
        "image": { "type": "string", "pattern": "^[^@[:space:]]+@sha256:[0-9a-f]{64}$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "platform": { "const": "linux/amd64" },
        "required_executables": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "contains": { "const": "pharness-worker" },
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
        },
        "preparation_strategy": { "enum": ["python_hashed_requirements", "node_npm_ci"] },
        "service_account": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
        "repository_allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+\\.git$" }
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory", "ephemeral_storage"],
          "properties": {
            "cpu": { "type": "string", "minLength": 1 },
            "memory": { "type": "string", "minLength": 1 },
            "ephemeral_storage": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
