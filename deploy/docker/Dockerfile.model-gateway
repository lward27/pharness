FROM --platform=$BUILDPLATFORM rust:1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS builder
ARG TARGETARCH
WORKDIR /build
# Keep the compiler layer independent of source and release identity.
COPY rust-toolchain.toml ./
RUN test "${TARGETARCH}" = "amd64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu libc6-dev-amd64-cross \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-gnu
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
ARG PHARNESS_BUILD_REVISION=unknown
ENV PHARNESS_BUILD_REVISION="${PHARNESS_BUILD_REVISION}"
# Shared BuildKit caches keep dependency and incremental compilation across
# images and releases; the target directory is a cache mount, so copy the
# built binaries into the layer explicitly.
RUN --mount=type=cache,id=pharness-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=pharness-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=pharness-target-x86_64,target=/build/target \
    cargo build --release --target x86_64-unknown-linux-gnu -p pharness-model-gateway \
    && mkdir -p /build/out && cp target/x86_64-unknown-linux-gnu/release/pharness-model-gateway /build/out/

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
ARG PHARNESS_BUILD_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/lward27/pharness" \
      org.opencontainers.image.revision="${PHARNESS_BUILD_REVISION}"
ENV PHARNESS_BUILD_REVISION="${PHARNESS_BUILD_REVISION}"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* /usr/bin/apt* /usr/bin/dpkg* \
    && rm -f /bin/sh /bin/dash /bin/bash /usr/bin/bash
COPY --from=builder /build/out/pharness-model-gateway /usr/local/bin/pharness-model-gateway
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pharness-model-gateway"]
