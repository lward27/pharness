# Node 24 runner for immutable PHarness repository preparation and coding.
# The final image contains no Docker/Podman client or usable OS package manager
# and runs as the non-root worker UID on a read-only root filesystem.
FROM --platform=$BUILDPLATFORM rust:1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS builder
ARG TARGETARCH
WORKDIR /build
# Keep the compiler layer independent of source and release identity.
COPY rust-toolchain.toml ./
RUN test "${TARGETARCH}" = "amd64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu libc6-dev-amd64-cross \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-gnu
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
ARG PHARNESS_BUILD_REVISION=unknown
ENV PHARNESS_BUILD_REVISION="${PHARNESS_BUILD_REVISION}"
# Shared BuildKit caches keep dependency and incremental compilation across
# images and releases; the target directory is a cache mount, so copy the
# built binaries into the layer explicitly.
RUN --mount=type=cache,id=pharness-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=pharness-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=pharness-target-x86_64,target=/build/target \
    cargo build --release --target x86_64-unknown-linux-gnu -p pharness-worker -p pharness-codex-host \
    && mkdir -p /build/out && cp target/x86_64-unknown-linux-gnu/release/pharness-codex-host target/x86_64-unknown-linux-gnu/release/pharness-worker /build/out/

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS codex
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/docker/install-codex.sh /usr/local/bin/install-codex
RUN chmod 0755 /usr/local/bin/install-codex \
    && TARGETARCH="${TARGETARCH}" /usr/local/bin/install-codex /out/codex

# The npm bundled with Node 24 carries undici and brace-expansion releases with
# fixed High advisories. npm bundles all of its dependencies, so the verified
# tarball installs offline.
FROM codex AS npm-dist
RUN mkdir -p /npm \
    && curl -fsSL --proto '=https' --tlsv1.2 -o /npm/npm-11.21.2.tgz \
      https://registry.npmjs.org/npm/-/npm-11.21.2.tgz \
    && printf '%s  %s\n' \
      '8ad8563b81e71b90ef405b140bccf3ba9b5e7884ab210bd49ee4e2f4bc6f61f5' \
      '/npm/npm-11.21.2.tgz' \
      | sha256sum --check --status

FROM node:24-bookworm-slim@sha256:a43f7fc3e52e87d12a905f46eea0275def84ca8f2981a5b53fed44d7fb398ee0
ARG PHARNESS_BUILD_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/lward27/pharness" \
      org.opencontainers.image.revision="${PHARNESS_BUILD_REVISION}"
ENV PHARNESS_BUILD_REVISION="${PHARNESS_BUILD_REVISION}" \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false
RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 pharness \
    && useradd --uid 65532 --gid 65532 --home-dir /workspace --no-create-home pharness \
    && rm -f /usr/bin/apt* /usr/bin/dpkg* /usr/sbin/dpkg*
RUN --mount=type=bind,from=npm-dist,source=/npm,target=/tmp/npm-dist \
    npm install --global --offline --update-notifier=false --cache /tmp/npm-cache /tmp/npm-dist/npm-11.21.2.tgz \
    && rm -rf /tmp/npm-cache \
    && test "$(npm --version)" = "11.21.2"
COPY --from=builder /build/out/pharness-worker /usr/local/bin/pharness-worker
COPY --from=builder /build/out/pharness-codex-host /usr/local/bin/pharness-codex-host
COPY --from=codex /out/codex /usr/local/bin/codex
COPY --from=codex /out/codex-linux-sandbox /usr/local/bin/codex-linux-sandbox
COPY --from=codex /out/codex-code-mode-host /usr/local/bin/codex-code-mode-host
COPY --from=codex /out/codex-resources /usr/local/bin/codex-resources
COPY deploy/codex-host/git-askpass /usr/lib/pharness-codex-host/git-askpass
RUN chmod 0755 /usr/lib/pharness-codex-host/git-askpass
RUN test -x /usr/local/bin/codex-linux-sandbox \
    && cmp -s /usr/local/bin/codex /usr/local/bin/codex-linux-sandbox \
    && test -x /usr/local/bin/codex-code-mode-host \
    && printf '%s  %s\n' \
      'b3d633427c8c75057fba11dad6051714d44886440305e86ba9d2c0366f4dd63b' \
      '/usr/local/bin/codex-code-mode-host' \
      | sha256sum --check --status
USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["pharness-worker"]
