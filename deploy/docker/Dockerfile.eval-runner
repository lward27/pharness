# Isolated live-evaluation image. It deliberately carries the Rust and Python
# toolchains required by the matched Builder fixtures, while upstream model
# credentials remain absent: the evaluator authenticates to the API with the
# worker identity and receives one single-use model grant per request.
FROM --platform=$BUILDPLATFORM rust:1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS builder
ARG PHARNESS_BUILD_REVISION=unknown
ARG TARGETARCH
ENV PHARNESS_BUILD_REVISION="${PHARNESS_BUILD_REVISION}"
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
# pharness-eval embeds the reviewed inference registry so the isolated runner
# cannot drift from the GitOps-qualified target and policy definitions.
COPY deploy/helm/pharness/files/inference-registry.json ./deploy/helm/pharness/files/inference-registry.json
RUN test "${TARGETARCH}" = "amd64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu libc6-dev-amd64-cross \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-gnu
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc
RUN cargo build --release --target x86_64-unknown-linux-gnu -p pharness-eval -p pharness-codex-host

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS codex
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/docker/install-codex.sh /usr/local/bin/install-codex
RUN chmod 0755 /usr/local/bin/install-codex \
    && TARGETARCH="${TARGETARCH}" /usr/local/bin/install-codex /out/codex

FROM rust:1-slim-bookworm@sha256:1469a27c125cb5a3aebfa4f4e4665d935b02fb72cc093b2c974b3d740e43f157 AS rust-runtime

# The frozen coding suite exercises Rust, Python, and Node repositories. Keep
# all three toolchains in this purpose-built evaluator image while avoiding the
# full build-essential Rust base that previously enlarged nodefs pressure.
FROM node:24-bookworm-slim@sha256:6642ef280aebc09c4541bee0b15c9f89f0f3f3c247ddee79ae1d37eddfdcbbaa
ARG PHARNESS_BUILD_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/lward27/pharness" \
      org.opencontainers.image.revision="${PHARNESS_BUILD_REVISION}"
ENV PHARNESS_BUILD_REVISION="${PHARNESS_BUILD_REVISION}" \
    PATH=/usr/local/cargo/bin:${PATH} \
    CARGO_HOME=/work/.cargo \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_NET_OFFLINE=true
RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap ca-certificates gcc git libc6-dev python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 pharness \
    && useradd --uid 65532 --gid 65532 --home-dir /work --create-home pharness \
    && rm -f /usr/bin/apt* /usr/bin/dpkg* /usr/sbin/dpkg*
COPY --from=rust-runtime /usr/local/cargo /usr/local/cargo
COPY --from=rust-runtime /usr/local/rustup /usr/local/rustup
COPY --from=builder /build/target/x86_64-unknown-linux-gnu/release/pharness-eval /usr/local/bin/pharness-eval
COPY --from=builder /build/target/x86_64-unknown-linux-gnu/release/pharness-codex-host /usr/local/bin/pharness-codex-host
COPY --from=codex /out/codex /usr/local/bin/codex
COPY --from=codex /out/codex-resources /usr/local/bin/codex-resources
COPY deploy/codex-host/git-askpass /usr/lib/pharness-codex-host/git-askpass
RUN chmod 0755 /usr/lib/pharness-codex-host/git-askpass
USER 65532:65532
WORKDIR /work
RUN test "$(id -u)" = "65532" \
    && cargo --version \
    && rustc --version \
    && python3 --version \
    && node --version \
    && npm --version \
    && git --version
ENTRYPOINT ["pharness-eval"]
