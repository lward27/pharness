# Portable PHarness Codex host. The same binary is packaged in the native
# bundle and in each language runner; this image is the immutable generic host
# artifact and Kubernetes packaging source.
FROM --platform=$BUILDPLATFORM rust:1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS builder
ARG PHARNESS_BUILD_REVISION=unknown
ARG TARGETARCH
ENV PHARNESS_BUILD_REVISION="${PHARNESS_BUILD_REVISION}"
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
RUN test "${TARGETARCH}" = "amd64" \
    && apt-get update \
    && apt-get install -y --no-install-recommends gcc-x86-64-linux-gnu libc6-dev-amd64-cross \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add x86_64-unknown-linux-gnu
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc
RUN cargo build --release --target x86_64-unknown-linux-gnu -p pharness-codex-host
RUN printf '%s\n' "${PHARNESS_BUILD_REVISION}" > /build/REVISION

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS codex
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/docker/install-codex.sh /usr/local/bin/install-codex
RUN chmod 0755 /usr/local/bin/install-codex \
    && TARGETARCH="${TARGETARCH}" /usr/local/bin/install-codex /out/codex

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime
ARG PHARNESS_BUILD_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/lward27/pharness" \
      org.opencontainers.image.revision="${PHARNESS_BUILD_REVISION}" \
      org.opencontainers.image.title="PHarness portable Codex agent host"
ENV PHARNESS_BUILD_REVISION="${PHARNESS_BUILD_REVISION}"
RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 pharness \
    && useradd --uid 65532 --gid 65532 --home-dir /var/lib/pharness-codex-host --create-home pharness
COPY --from=builder /build/target/x86_64-unknown-linux-gnu/release/pharness-codex-host /usr/local/bin/pharness-codex-host
COPY --from=codex /out/codex /usr/local/bin/codex
COPY --from=codex /out/codex-linux-sandbox /usr/local/bin/codex-linux-sandbox
COPY --from=codex /out/codex-code-mode-host /usr/local/bin/codex-code-mode-host
COPY --from=codex /out/codex-resources /usr/local/bin/codex-resources
COPY deploy/codex-host/git-askpass /usr/lib/pharness-codex-host/git-askpass
RUN chmod 0755 /usr/lib/pharness-codex-host/git-askpass
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/pharness-codex-host"]

# Execute the Linux/AMD64 binaries inside BuildKit before exporting the native
# bundle. The packaging command commonly runs from macOS, where directly
# executing the exported ELF files would fail even though the bundle is valid.
FROM runtime AS bundle-verification
RUN test "$(pharness-codex-host --version)" = "pharness-codex-host 0.1.0" \
    && codex --version | grep -F 'codex-cli 0.150.1' >/dev/null \
    && test -x /usr/local/bin/codex-linux-sandbox \
    && cmp -s /usr/local/bin/codex /usr/local/bin/codex-linux-sandbox \
    && codex-linux-sandbox --help >/dev/null \
    && test -x /usr/local/bin/codex-code-mode-host \
    && printf '%s  %s\n' \
      'b3d633427c8c75057fba11dad6051714d44886440305e86ba9d2c0366f4dd63b' \
      '/usr/local/bin/codex-code-mode-host' \
      | sha256sum --check --status \
    && test "$(command -v bwrap)" = '/usr/bin/bwrap' \
    && bwrap --version | grep -F 'bubblewrap' >/dev/null \
    && bwrap --help | grep -F -- '--as-pid-1' >/dev/null \
    && bwrap --help | grep -F -- '--perms' >/dev/null \
    && test -x /usr/local/bin/codex-resources/bwrap \
    && printf '%s  %s\n' \
      'c102c5f893faed17ed053ce6ceb9fe0bb03069b991a6f0390e54d82c85f1bca0' \
      '/usr/local/bin/codex-resources/bwrap' \
      | sha256sum --check --status \
    && /usr/local/bin/codex-resources/bwrap --version | grep -F 'bubblewrap' >/dev/null \
    && schema_dir="$(mktemp -d)" \
    && codex app-server generate-json-schema --experimental --out "${schema_dir}" \
    && grep -F '"permissionProfile"' "${schema_dir}/v2/CommandExecParams.json" >/dev/null \
    && grep -F '"permissions"' "${schema_dir}/v2/TurnStartParams.json" >/dev/null \
    && grep -F '"permissions"' "${schema_dir}/v2/ThreadStartParams.json" >/dev/null \
    && rm -rf "${schema_dir}"

FROM scratch AS bundle
ARG PHARNESS_BUILD_REVISION=unknown
COPY --from=builder /build/target/x86_64-unknown-linux-gnu/release/pharness-codex-host /pharness-codex-host/bin/pharness-codex-host
COPY --from=codex /out/codex /pharness-codex-host/bin/codex
COPY --from=codex /out/codex-linux-sandbox /pharness-codex-host/bin/codex-linux-sandbox
COPY --from=codex /out/codex-code-mode-host /pharness-codex-host/bin/codex-code-mode-host
COPY --from=codex /out/codex-resources /pharness-codex-host/bin/codex-resources
COPY --from=builder /build/REVISION /pharness-codex-host/REVISION
COPY deploy/codex-host/git-askpass /pharness-codex-host/libexec/git-askpass
COPY deploy/codex-host/config.toml.example /pharness-codex-host/etc/config.toml.example
COPY deploy/codex-host/pharness-codex-host.service /pharness-codex-host/lib/systemd/system/pharness-codex-host.service
COPY deploy/codex-host/install.sh /pharness-codex-host/install.sh
COPY deploy/codex-host/uninstall.sh /pharness-codex-host/uninstall.sh
COPY deploy/codex-host/enroll.sh /pharness-codex-host/enroll.sh
COPY deploy/codex-host/login.sh /pharness-codex-host/login.sh
