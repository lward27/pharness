{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["campus"],
  "model": "campus/campus-default",
  "small_model": "campus/campus-default",
  "default_agent": "tutor",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "deny"
  },
  "provider": {
    "campus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Campus models",
      "options": {
        "baseURL": "http://127.0.0.1:4791/v1",
        "apiKey": "campus-lab"
      },
      "models": {
        "campus-default": {
          "name": "Campus default model",
          "tool_call": true,
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    }
  }
}
