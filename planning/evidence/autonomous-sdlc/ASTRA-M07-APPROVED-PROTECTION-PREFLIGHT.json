          "raw_url": "https://github.com/lward27/yfinance_wrapper/raw/3fe7495b23b989af70acb4c48e7661334d829d01/.github%2Fworkflows%2Fsource-integrity.yml",
          "contents_url": "https://api.github.com/repos/lward27/yfinance_wrapper/contents/.github%2Fworkflows%2Fsource-integrity.yml?ref=3fe7495b23b989af70acb4c48e7661334d829d01",
          "patch": "@@ -0,0 +1,31 @@\n+name: Source integrity\n+\n+'on':\n+  pull_request:\n+    branches: [main]\n+  push:\n+    branches: [main]\n+\n+permissions:\n+  contents: read\n+\n+concurrency:\n+  group: source-integrity-${{ github.ref }}\n+  cancel-in-progress: true\n+\n+jobs:\n+  source-integrity:\n+    name: Source integrity\n+    runs-on: ubuntu-24.04\n+    timeout-minutes: 60\n+    steps:\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n+        with:\n+          persist-credentials: false\n+      - name: Test the exact proposed tree with the release Dockerfile\n+        shell: bash\n+        run: |\n+          set -euo pipefail\n+          source_revision=$(git rev-parse HEAD)\n+          docker build --platform linux/amd64 --pull \\\n+            --build-arg \"SOURCE_COMMIT=$source_revision\" ."
        }
      ],
