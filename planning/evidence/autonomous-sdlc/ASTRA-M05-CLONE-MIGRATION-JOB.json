{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "astra-m05-clone-migration-0052-20260905",
    "namespace": "pharness",
    "labels": {
      "app.kubernetes.io/part-of": "pharness",
      "pharness.dev/program": "astra-autonomous-sdlc",
      "pharness.dev/purpose": "clone-migration-0052"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 300,
    "template": {
      "metadata": {
        "labels": {
          "pharness.dev/purpose": "clone-migration-0052"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "kubernetes.io/hostname": "ubuntu-lucas-engineering"
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 65532,
          "runAsGroup": 65532,
          "fsGroup": 65532,
          "fsGroupChangePolicy": "OnRootMismatch",
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "volumes": [
          {
            "name": "data",
            "persistentVolumeClaim": {
              "claimName": "pharness-api-data-finance-20260827"
            }
          },
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "128Mi"
            }
          },
          {
            "name": "scratch",
            "emptyDir": {
              "sizeLimit": "128Mi"
            }
          }
        ],
        "initContainers": [
          {
            "name": "copy-archive",
            "image": "registry.lucas.engineering/pharness-python-runner@sha256:e96a79b465c0ccb4321d8dcde9c14e6436bfb2c7d57d397629810762e48089c1",
            "command": [
              "python",
              "-c",
              "import hashlib,pathlib,shutil; p=pathlib.Path(\"/data/archives/ASTRA-pre-0052-20260905/pharness.db\"); assert \"sha256:\"+hashlib.sha256(p.read_bytes()).hexdigest()==\"sha256:fbc7e2873e71202ae90fcb1fe28e6f160e189e9adc5c29ab395cb39ce7c29d3f\"; shutil.copyfile(p,\"/scratch/pharness.db\"); print(\"Verified archive copied into isolated temporary storage\")"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/data",
                "readOnly": true
              },
              {
                "name": "scratch",
                "mountPath": "/scratch"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ]
          },
          {
            "name": "migrate-reader",
            "image": "registry.lucas.engineering/pharness-runtime@sha256:12176080848f9f3e4ffd33873f697e731d2a49077059d900406f909603464171",
            "command": [
              "sh",
              "-ec",
              "pharness-api > /scratch/api.log 2>&1 & reader_pid=$!; trap 'kill \"$reader_pid\" 2>/dev/null || true' EXIT; ready=false; for check in $(seq 1 30); do if curl --silent --fail --max-time 1 http://127.0.0.1:4777/health >/scratch/health.json; then ready=true; break; fi; kill -0 \"$reader_pid\"; sleep 1; done; test \"$ready\" = true; cat /scratch/health.json; kill \"$reader_pid\"; wait \"$reader_pid\" || true; trap - EXIT"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "scratch",
                "mountPath": "/scratch"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ],
            "workingDir": "/scratch",
            "env": [
              {
                "name": "PHARNESS_DB_PATH",
                "value": "/scratch/pharness.db"
              },
              {
                "name": "PHARNESS_WORKSPACE_ROOT",
                "value": "/scratch/workspaces"
              },
              {
                "name": "PHARNESS_BIND",
                "value": "127.0.0.1:4777"
              },
              {
                "name": "PHARNESS_DATABASE_GENERATION_ID",
                "value": "dbgen_finance_20260827"
              },
              {
                "name": "PHARNESS_DATABASE_GENERATION_ADOPT_EXISTING",
                "value": "false"
              },
              {
                "name": "PHARNESS_OPERATIONAL_MODE",
                "value": "draining"
              },
              {
                "name": "PHARNESS_WORKER_MODE",
                "value": "local"
              },
              {
                "name": "PHARNESS_RETENTION_SCHEDULED_ENABLED",
                "value": "false"
              },
              {
                "name": "PHARNESS_RETENTION_AUTOMATIC_EXECUTION_ENABLED",
                "value": "false"
              }
            ]
          }
        ],
        "containers": [
          {
            "name": "verify-migration",
            "image": "registry.lucas.engineering/pharness-python-runner@sha256:e96a79b465c0ccb4321d8dcde9c14e6436bfb2c7d57d397629810762e48089c1",
            "command": [
              "python",
              "-c",
              "import sqlite3,json,pathlib,hashlib\nroot=pathlib.Path(\"/data/archives/ASTRA-pre-0052-20260905\")\noriginal=sqlite3.connect(\"file:\"+str(root/\"pharness.db\")+\"?mode=ro\",uri=True)\nchanged=sqlite3.connect(\"file:/scratch/pharness.db?mode=ro\",uri=True)\nassert changed.execute(\"PRAGMA integrity_check\").fetchone()[0]==\"ok\"\nversions=changed.execute(\"SELECT version,success FROM _sqlx_migrations ORDER BY version\").fetchall()\nassert len(versions)==52 and versions[-1]==(52,1)\nassert changed.execute(\"SELECT count(*) FROM work_items WHERE workflow_policy_json IS NOT NULL OR workflow_policy_hash IS NOT NULL\").fetchone()[0]==0\nquery=\"SELECT id,status,source_commit,closed_at,closure_reason,state_version FROM work_items ORDER BY id\"\nassert changed.execute(query).fetchall()==original.execute(query).fetchall()\ncounts={}\nfor table in [\"work_items\",\"runs\",\"stage_executions\",\"stage_outcomes\",\"evidence_validations\",\"audit_events\",\"retention_holds\",\"products\",\"repositories\",\"database_generations\"]:\n a=original.execute(\"SELECT count(*) FROM \"+table).fetchone()[0]\n b=changed.execute(\"SELECT count(*) FROM \"+table).fetchone()[0]\n assert a==b,(table,a,b)\n counts[table]=b\nassert changed.execute(\"SELECT * FROM database_generations\").fetchall()==original.execute(\"SELECT * FROM database_generations\").fetchall()\nprint(json.dumps({\"integrity\":\"ok\",\"maximum_migration\":52,\"applied_migrations\":len(versions),\"legacy_policy_rows\":0,\"historical_work_items_identical\":True,\"preserved_counts\":counts,\"source_migration_unchanged\":original.execute(\"SELECT max(version) FROM _sqlx_migrations\").fetchone()[0],\"runtime_health\":json.loads(pathlib.Path(\"/scratch/health.json\").read_text())}))\n"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "50m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "data",
                "mountPath": "/data",
                "readOnly": true
              },
              {
                "name": "scratch",
                "mountPath": "/scratch"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ]
          }
        ]
      }
    }
  }
}
